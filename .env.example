APP_NAME=OAP Backend
API_V1_PREFIX=/api/v1
APP_ENV=local

# Local development only. Local PostgreSQL is allowed only with APP_ENV=local.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/oap_db

# Production must set APP_ENV=production and use Supabase PostgreSQL.
# Do not commit real credentials.
# DATABASE_URL=postgresql+psycopg://<pooler_user>:<password>@<pooler_host>:<pooler_port>/<database>?sslmode=require

# Tests may set APP_ENV=test and inject TEST_DATABASE_URL explicitly.
# TEST_DATABASE_URL=sqlite://

OPENAI_API_KEY=

# Comma-separated browser origins. Production frontend origin is deployment-specific.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Authentication. Keep secret values empty in this example.
JWT_SECRET=
JWT_ISSUER=oap-backend
JWT_AUDIENCE=oap-web
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# Google Identity Services public web client ID (not a client secret).
GOOGLE_CLIENT_ID=

# Production cross-site cookies require Secure=true and SameSite=None.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
