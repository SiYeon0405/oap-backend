    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Signup A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('emailA', `codex-postman-a-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('signup response fields exist', () => { const body = pm.response.json(); ['id','email','name','status','createdAt'].forEach(k => pm.expect(body).to.have.property(k)); });",
                  "pm.test('response has no tokens', () => { const body = pm.response.json(); pm.expect(body).not.to.have.property('access_token'); pm.expect(body).not.to.have.property('refresh_token'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{passwordA}}\",\n  \"name\": \"{{signupName}}\",\n  \"termsAgreed\": true,\n  \"privacyAgreed\": true,\n  \"marketingAgreed\": {{marketingAgreed}}\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/api/v1/auth/signup",
            "description": "인증 없이 사용자 A를 생성합니다. 토큰이나 Cookie를 발급하지 않습니다."
          }
        },
        {
          "name": "Login A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('email is A', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('emailA')));",
                  "pm.test('response has no tokens', () => { const body = pm.response.json(); pm.expect(body).not.to.have.property('access_token'); pm.expect(body).not.to.have.property('refresh_token'); });"
                ]
