            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{deleteEmail}}\",\n  \"password\": \"{{deletePassword}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "탈퇴 전용 사용자의 Cookie를 발급합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Delete Current Account",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Origin", "value": "{{allowedOrigin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{deletePassword}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "주의: 계정과 사용자 소유 데이터가 삭제되는 파괴적 요청입니다. Collection Runner와 운영 환경에서 자동 실행하지 마세요. 이 요청 Body는 일반 계정용이며 password로 재인증합니다. Google 계정은 별도로 {\"idToken\":\"{{googleIdToken}}\"} Body만 사용하고 탈퇴 직전에 받은 최신 Google ID Token을 전달합니다. password와 idToken을 동시에 보내지 마세요."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Me After Account Deletion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "회원 탈퇴 후 Access HttpOnly Cookie 인증이 거부되는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Refresh After Account Deletion",
          "request": {
            "method": "POST",
            "header": [{"key": "Origin", "value": "{{allowedOrigin}}"}],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "회원 탈퇴 후 Refresh 인증이 거부되는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
